    "twilio": {
      "_label": "Twilio (SMS + WhatsApp)",
      "fields": {
        "accountSid": {
          "value": "",
          "description": "Account SID",
          "whereToGet": "Twilio Console → Account → API keys & tokens",
          "secret": true,
          "required": true,
          "format": "AC + 32 hex characters",
          "target": "Firebase secret TWILIO_ACCOUNT_SID",
          "readByCodeToday": true
        },
        "authToken": {
          "value": "",
          "description": "Auth token",
          "whereToGet": "Twilio Console → Account → API keys & tokens → Auth token",
          "secret": true,
          "required": true,
          "format": "32 hex characters",
          "target": "Firebase secret TWILIO_AUTH_TOKEN",
          "readByCodeToday": true
        },
        "smsFrom": {
          "value": "",
          "description": "SMS sender number",
          "whereToGet": "Twilio Console → Phone Numbers → Active numbers",
          "secret": true,
          "required": true,
          "format": "E.164 phone, e.g. +12025550100",
          "target": "Firebase secret TWILIO_FROM_NUMBER",
          "readByCodeToday": true
        },
        "whatsappFrom": {
          "value": "",
          "description": "WhatsApp production sender",
          "whereToGet": "Twilio Console → Messaging → Senders → WhatsApp senders (approved FLOQR number, not the sandbox +14155238886)",
          "secret": true,
          "required": true,
          "format": "whatsapp:+<E.164>, e.g. whatsapp:+12025550100",
          "target": "Firebase secret TWILIO_WHATSAPP_FROM",
          "readByCodeToday": true
        },
        "whatsappOtpContentSid": {
          "value": "",
          "description": "WhatsApp OTP Authentication template SID",
          "whereToGet": "Twilio Console → Messaging → Content Template Builder → approved WhatsApp Authentication template (HX…)",
          "secret": false,
          "required": true,
          "format": "HX + 32 hex characters (Content Template SID)",
          "target": "functions/.env TWILIO_WHATSAPP_OTP_CONTENT_SID",
          "readByCodeToday": true
        }
      },
      "manual": {
        "whatsappSenderRegistered": {
          "value": false,
          "description": "Production WhatsApp sender registered with Meta Business verification, display name FLOQR",
          "target": "Console-only manual step"
        },
        "otpTemplateApproved": {
          "value": false,
          "description": "Authentication template (copy-code, {{1}} = 6-digit code) approved by Meta for en (+ fr, es, de, pt, it, ar)",
          "target": "Console-only manual step"
        }
      }
    },
