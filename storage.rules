rules_version = '2';

// FLOQR STORAGE RULES VERSION: s3.1.26-mingl-media-members
// EXPECTED DEPLOYED STORAGE RULES VERSION: s3.1.26-mingl-media-members or newer
// - mingl-chat/ and mingl-chat-backgrounds/: read by the uploader or a member of chatRooms/{roomId}; upload by a member
// - Master Admin email list needs email_verified (masterAdmin claim unchanged); unowned typo address removed
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR STORAGE RULES VERSION: s3.1.25-club-media-admins
// - clubMedia/{clubLocationId}/... writes/deletes: Master Admin or a Club Admin of that club only
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR STORAGE RULES VERSION: s3.1.0-ad-media
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR STORAGE RULES VERSION: v29.06
// - adMedia/{uid}/... ad flyers (image < 8 MB) and videos (< 60 MB, length checked by Functions)
// - adIntake/... SMS / WhatsApp ad media, written by Functions only
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR STORAGE RULES VERSION: v28.59-storage-lifecycle-rules
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR STORAGE RULES VERSION: v28.57-storage-media-rules
// Required media paths:
// - shoutouts/{uid}/... for original, enhanced, and trimmed ShoutOut media
// - profileMedia/{uid}/images/... and profileMedia/{uid}/videos/...
// - template-backgrounds/{uid}/{variantId}/... for patron template background media
// - mingl-chat/{uid}/{roomId}/... for owner-uploaded Mingl chat pictures/videos
// - mingl-chat-backgrounds/{uid}/{roomId}/... for owner-uploaded per-chat background images
// - clubMedia/{clubLocationId}/... for club logos, public profile media, main media, and marketing gallery
// - explicit owner delete support so Diagnostics can upload/read/delete smoke-test media
// If Firebase Console Storage Rules does not show this note near the top, Storage rules are not updated to this package.

service firebase.storage {
  match /b/{bucket}/o {

    // Mirrors firestore.rules isMasterAdmin() / isClubManager(). Storage rules may read at most
    // 2 Firestore docs per request: clubLocations/{id} + clubAdminAssignments/{id}_{uid}.
    // The Storage service agent needs roles/firebaserules.firestoreServiceAgent; --non-interactive deploys skip that grant check.
    // Design notes: .cursor/rules/design-notes-data-classification.mdc → "Seed endpoints + clubMedia storage"
    function isStorageMasterAdmin() {
      return request.auth != null
        && (
          request.auth.token.get("masterAdmin", false) == true
          || (
            request.auth.token.get("email_verified", false) == true
            && request.auth.token.get("email", "") in [
              "bans.don@gmail.com",
              "don.b@jadzholdings.com"
            ]
          )
        );
    }

    function clubLocationData(clubId) {
      return firestore.get(/databases/(default)/documents/clubLocations/$(clubId)).data;
    }

    function isClubLocationAdmin(clubId) {
      return firestore.exists(/databases/(default)/documents/clubLocations/$(clubId))
        && (
          request.auth.uid in clubLocationData(clubId).get("adminUids", [])
          || request.auth.uid in clubLocationData(clubId).get("masterAdminUids", [])
          || (
            request.auth.token.email is string
            && request.auth.token.email in clubLocationData(clubId).get("adminEmails", [])
          )
        );
    }

    function hasActiveClubAdminAssignment(clubId) {
      return firestore.exists(/databases/(default)/documents/clubAdminAssignments/$(clubId + "_" + request.auth.uid))
        && firestore.get(/databases/(default)/documents/clubAdminAssignments/$(clubId + "_" + request.auth.uid)).data.get("status", "") == "active";
    }

    function isClubMediaManager(clubId) {
      return request.auth != null
        && (
          isStorageMasterAdmin()
          || isClubLocationAdmin(clubId)
          || hasActiveClubAdminAssignment(clubId)
        );
    }

    match /shoutouts/{userId}/{allPaths=**} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 30 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('video/.*')
        );

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /profileMedia/{userId}/images/{allPaths=**} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /profileMedia/{userId}/videos/{allPaths=**} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 60 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /template-backgrounds/{userId}/{variantId}/{allPaths=**} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 30 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('video/.*')
        );

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Mingl chat media: the uploader or a member of chatRooms/{roomId} (1 Firestore read).
    // Master Admin may upload without a room for Diagnostics smoke tests.
    function isChatRoomMember(roomId) {
      return request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/chatRooms/$(roomId)).data.get("participants", []);
    }

    function canReadChatMedia(userId, roomId) {
      return request.auth != null
        && (request.auth.uid == userId || isChatRoomMember(roomId));
    }

    function canWriteChatMedia(userId, roomId) {
      return request.auth != null
        && request.auth.uid == userId
        && (isStorageMasterAdmin() || isChatRoomMember(roomId));
    }

    match /mingl-chat/{userId}/{roomId}/{allPaths=**} {
      allow read: if canReadChatMedia(userId, roomId);

      allow create, update: if canWriteChatMedia(userId, roomId)
        && request.resource.size < 30 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('video/.*')
        );

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /mingl-chat-backgrounds/{userId}/{roomId}/{allPaths=**} {
      allow read: if canReadChatMedia(userId, roomId);

      allow create, update: if canWriteChatMedia(userId, roomId)
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /clubMedia/{clubLocationId}/{allPaths=**} {
      allow read: if true;

      allow create, update: if isClubMediaManager(clubLocationId)
        && request.resource.size < 60 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('video/.*')
        );

      allow delete: if isClubMediaManager(clubLocationId);
    }

    match /spotAds/{userId}/{allPaths=**} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /adMedia/{userId}/{allPaths=**} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && (
          (request.resource.contentType.matches('image/(jpeg|png|gif|webp)') && request.resource.size < 8 * 1024 * 1024) ||
          (request.resource.contentType.matches('video/(mp4|quicktime|3gpp)') && request.resource.size < 60 * 1024 * 1024)
        );

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /adIntake/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
