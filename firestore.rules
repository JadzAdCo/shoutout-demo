 allow write: if false;
 }

 match /suprstarRequests/{requestId} {
 allow read: if signedIn() && (
 resource.data.broadcasterUid == request.auth.uid
 || isClubManager(resource.data.locationId)
 || isMasterAdmin()
 );
 allow write: if false;
 }

 // Venue live pointer — public read so display boards can attach (session id is unguessable).
 match /suprstrLive/{locationId} {
 allow read: if true;
 allow write: if false;
 }

 // WebRTC signaling — session ids are random; broadcaster + display board only.
 match /suprstrSessions/{sessionId} {
 allow read: if true;
 allow create: if false;
 allow update: if isMasterAdmin()
 || (
 signedIn()
 && resource.data.broadcasterUid == request.auth.uid
 && resource.data.status in ["waiting", "offering", "connected"]
 && request.resource.data.diff(resource.data).affectedKeys()
 .hasOnly(["offer", "answer", "status", "updatedAt"])
 && request.resource.data.status in ["waiting", "offering", "connected"]
 )
 || (
 resource.data.status in ["waiting", "offering", "connected"]
 && request.resource.data.diff(resource.data).affectedKeys()
 .hasOnly(["answer", "status", "answeredAt", "updatedAt"])
 && request.resource.data.status in ["offering", "connected"]
 );
 allow delete: if isMasterAdmin();

 match /callerCandidates/{candidateId} {
 allow read: if true;
 allow create: if signedIn()
 && get(/databases/$(database)/documents/suprstrSessions/$(sessionId)).data.broadcasterUid == request.auth.uid;
 allow update, delete: if false;
 }
 // Xibo display2 is not signed in: it may only add ICE candidates to a live session, for 4 hours.
 match /calleeCandidates/{candidateId} {
 allow read: if true;
 allow create: if suprstrSessionAcceptsCandidates(sessionId) && isIceCandidateShape();
 allow update, delete: if false;
 }
 }

 match /scheduleShifts/{id} {
 allow read: if isMasterAdmin()
 || resource.data.get("workerUid", "") == request.auth.uid
 || isClubManager(resource.data.get("clubLocationId", "none"));
 allow write: if false;
 }

 match /scheduleNotifyQueue/{id} {
 allow read: if isMasterAdmin();
 allow write: if false;
 }

 match /scheduleShiftAudit/{id} {
 allow read: if isMasterAdmin() || isClubManager(resource.data.get("clubLocationId", "none"));
 allow write: if false;
 }

 match /shoutoutAudit/{id} {
 allow create: if signedIn()
 && request.resource.data.shoutoutId is string
 && request.resource.data.action is string
 && request.resource.data.actorUid == request.auth.uid;
 allow read: if isMasterAdmin()
 || (
 signedIn()
 && (
 resource.data.actorUid == request.auth.uid
 || resource.data.ownerUid == request.auth.uid
 || resource.data.submittedByUid == request.auth.uid
 )
 );
 allow update, delete: if false;
 }

 match /shoutoutComplianceLogs/{shoutoutId} {
 allow read: if isMasterAdmin();
 allow create, update, delete: if false;
 }

 match /shoutoutComplianceMeta/{id} {
 allow read: if isMasterAdmin();
 allow create, update, delete: if false;
 }

 match /djProfiles/{id} {
 allow read: if true;
 allow create, update, delete: if signedIn();
 }

 match /promoterProfiles/{id} {
 allow read: if true;
 allow create, update, delete: if signedIn();
 }

 match /shoutoutRecommendations/{id} {
 allow read: if isMasterAdmin()
 || (
 signedIn()
 && (
 resource.data.status == "approved"
 || resource.data.uid == request.auth.uid
 )
 );
 allow create: if isMasterAdmin()
 || (
 signedIn()
 && request.resource.data.uid == request.auth.uid
 && request.resource.data.status == "pending"
 );
 allow update, delete: if isMasterAdmin();
 }

 match /aiIndex/{id} {
 allow read: if resource.data.visibility == "public"
 || (
 signedIn()
 && (
 resource.data.ownerUid == request.auth.uid
 || resource.data.visibility == "shared"
 )
 );
 allow create, update: if signedIn()
 && request.resource.data.visibility in ["public", "shared", "private"];
 allow delete: if signedIn();
 }

 match /aiUserNotificationPreferences/{uid} {
 allow read, write: if isSelf(uid);
 }

 match /aiUserSignals/{id} {
 allow create: if createsOwnUid();
 allow read, update, delete: if ownsResourceUid();
 }

 match /aiSearchLogs/{id} {
 allow create: if createsOwnUid();
 allow read, update, delete: if ownsResourceUid();
 }

 match /aiRecommendations/{id} {
 allow create: if isMasterAdmin()
 || (signedIn()
 && (
 request.resource.data.get("uid", "") == request.auth.uid
 || request.resource.data.get("recipientUid", "") == request.auth.uid
 ));
 allow read, update, delete: if signedIn()
 && (
 resource.data.uid == request.auth.uid
 || resource.data.recipientUid == request.auth.uid
 );
 }

 match /aiMediaEdits/{id} {
 allow read, update, delete: if ownsResourceUid();
 allow create: if createsOwnUid();
 }

 match /aiDiscoverySources/{id} {
 allow read: if isMasterAdmin();
 allow write: if isMasterAdmin();
 }

 match /aiDiscoveryQueue/{id} {
 allow read: if isMasterAdmin()
 || (signedIn()
 && resource.data.discoveryMode == "profile-import-draft");
 allow create, update, delete: if isMasterAdmin();
 }

 match /aiDiscoveryRatingCriteria/{id} {
 allow read: if isMasterAdmin();
 allow write: if isMasterAdmin();
 }

 match /aiCrawlRuns/{id} {
 allow read: if isMasterAdmin();
 allow write: if isMasterAdmin();
 }

 match /aiCrawlerSchedules/{id} {
 allow read: if isMasterAdmin();
 allow write: if isMasterAdmin();
 }

 match /aiDiagnosticsReports/{id} {
 allow read, write: if isMasterAdmin();
 }

 match /aiAssistantSessions/{uid} {
 allow read, write: if isSelf(uid);
 }

 match /aiAssistantMessages/{id} {
 allow create: if createsOwnUid();
 allow read, update, delete: if ownsResourceUid();
 }

 match /patronShoutoutArchives/{archiveId} {
 allow create: if signedIn()
 && request.resource.data.ownerUid == request.auth.uid
 && request.resource.data.shoutoutId is string
 && request.resource.data.retained == true;
 allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
 allow update, delete: if false;
 }

 match /patronTemplateVariants/{variantId} {
 allow create: if signedIn()
 && request.resource.data.ownerUid == request.auth.uid;

 allow read: if signedIn()
 && (
 resource.data.ownerUid == request.auth.uid ||
 resource.data.visibility == "public"
 );

 allow update, delete: if signedIn()
 && resource.data.ownerUid == request.auth.uid;
 }

 match /clubTemplateVariants/{variantId} {
 allow read: if signedIn();

 allow create: if signedIn()
 && request.resource.data.ownerUid == request.auth.uid
 && request.resource.data.variantScope == "club"
 && request.resource.data.clubLocationId is string;

 allow update, delete: if signedIn();
 }

 match /aiTemplatePromptHistory/{id} {
 allow create: if createsOwnUid();
 allow read, update, delete: if ownsResourceUid();
 }

 match /minglConnections/{connectionId} {
 allow read: if isParticipant()
 || (
 signedIn()
 && (
 resource.data.requestedBy == request.auth.uid ||
 resource.data.requestedTo == request.auth.uid
 )
 );
 allow create: if isNewParticipant()
 && request.resource.data.participants.size() == 2
 && request.auth.uid == request.resource.data.requestedBy;
 // Accept / deny / refresh: either party on the request may update.
 // Do not require participants list identity — order often differs between clients.
 allow update: if signedIn()
 && (
 request.auth.uid == resource.data.requestedTo ||
 request.auth.uid == resource.data.requestedBy ||
 (
 resource.data.participants is list
 && request.auth.uid in resource.data.participants
 )
 )
 && request.resource.data.participants is list
 && request.resource.data.participants.size() == 2
 && request.auth.uid in request.resource.data.participants;
 allow delete: if isDiagnosticParticipantResource();
 }

 match /minglAudit/{id} {
 allow create: if signedIn()
 && request.resource.data.participants is list
 && request.auth.uid in request.resource.data.participants;
 allow read: if signedIn()
 && resource.data.participants is list
 && request.auth.uid in resource.data.participants;
 allow update, delete: if signedIn()
 && resource.data.actorUid == request.auth.uid;
 }

 match /minglGists/{id} {
 allow read: if true;
 allow create: if signedIn()
 && request.resource.data.authorUid is string
 && request.resource.data.authorUid == request.auth.uid;
 allow update, delete: if signedIn()
 && (
 resource.data.authorUid == request.auth.uid
 || isMasterAdmin()
 );
 }

 // s3.1.0 ads: every write goes through Functions (createAdCampaign → Stripe → approveAdCampaign).
 // Design notes: .cursor/rules/design-notes-ad-campaigns-business.mdc
 match /spotAdCampaigns/{id} {
 allow read: if resource.data.status == "active"
 || isMasterAdmin()
 || (signedIn() && resource.data.publishedByUid == request.auth.uid);
 allow create, update, delete: if false;
 }

 match /adCampaignPrivate/{id} {
 allow read: if isMasterAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
 allow write: if false;
 }

 match /adInvoices/{id} {
 allow read: if isMasterAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
 allow write: if false;
 }

 match /adSettings/{id} {
 allow read: if true;
 allow write: if false;
 }

 match /adStats/{id} {
 allow read: if isMasterAdmin();
 allow write: if false;
 }

 match /adStatsDaily/{id} {
 allow read: if isMasterAdmin();
 allow write: if false;
 }

 match /adPosterDelegations/{id} {
 allow read: if isMasterAdmin()
 || (signedIn() && (resource.data.uid == request.auth.uid || isClubManager(resource.data.clubLocationId)));
 allow write: if false;
 }

 match /promotionGroups/{id} {
 allow read: if isMasterAdmin() || (signedIn() && request.auth.uid in resource.data.memberUids);
 allow write: if false;
 }

 match /adIntakeSubmissions/{id} {
 allow read: if isMasterAdmin();
 allow write: if false;
 }

 match /adInvoiceAccounts/{id} {
 allow read: if isMasterAdmin();
 allow write: if false;
 }

 match /adAuditLogs/{id} {
 allow read: if isMasterAdmin();
 allow write: if false;
 }

 match /adEventDedupe/{id} {
 allow read, write: if false;
 }

 match /adEventThrottle/{id} {
 allow read, write: if false;
 }

 match /adIntakeOptOuts/{id} {
 allow read, write: if false;
 }

 match /chatRooms/{roomId} {
 allow read: if signedIn()
 && (
 isParticipant() ||
 !isExistingMinglRoom()
 );
 allow create: if signedIn()
 && (
 (
 isNewMinglRoom()
 && isNewParticipant()
 && request.resource.data.connectionId is string
 && isMutualMingl(request.resource.data.connectionId)
 ) ||
 !isNewMinglRoom()
 );
 allow update: if signedIn()
 && (
 (
 isExistingMinglRoom()
 && isParticipant()
 && resource.data.connectionId is string
 && isMutualMingl(resource.data.connectionId)
 ) ||
 !isExistingMinglRoom()
 );
 allow delete: if signedIn()
 && (
 !isExistingMinglRoom() ||
 (isExistingMinglRoom() && isDiagnosticParticipantResource())
 );
 }

 match /chatMessages/{messageId} {
 allow read: if signedIn()
 && (
 (
 isExistingMinglMessage()
 && resource.data.participants is list
 && request.auth.uid in resource.data.participants
 ) ||
 !isExistingMinglMessage()
 );
 allow create: if signedIn()
 && (
 (
 isNewMinglMessage()
 && (
 request.auth.uid == request.resource.data.senderUid ||
 isMinglSystemMessageRequest()
 )
 && request.resource.data.participants is list
 && request.auth.uid in request.resource.data.participants
 && exists(/databases/$(database)/documents/chatRooms/$(request.resource.data.roomId))
 && get(/databases/$(database)/documents/chatRooms/$(request.resource.data.roomId)).data.type == "mingl"
 && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(request.resource.data.roomId)).data.participants
 && isMutualMingl(get(/databases/$(database)/documents/chatRooms/$(request.resource.data.roomId)).data.connectionId)
 ) ||
 !isNewMinglMessage()
 );
 allow update: if signedIn()
 && (
 !isExistingMinglMessage() ||
 isOwnMinglMessageEdit() ||
 isMinglReadReceiptUpdate() ||
 isMinglBackgroundConsentUpdate() ||
 isMinglDeleteAfterReadExpiry() ||
 (isExistingMinglMessage() && isDiagnosticParticipantResource())
 );
 allow delete: if signedIn()
 && (
 !isExistingMinglMessage() ||
 (isExistingMinglMessage() && isDiagnosticParticipantResource())
 );
 }

 // Master Admin manifest docs (demo account codes, etc.) — Admin SDK writes; client read for Master Admin.
 match /system/{docId} {
 allow read: if isMasterAdmin();
 allow write: if false;
 }

 // iPhone mobile test checklist runs (Admin SDK writes; client merge when signed in)
 match /mobileTestRuns/{runId} {
 allow read: if isMasterAdmin()
 || (signedIn() && resource.data.uid == request.auth.uid)
 || (signedIn() && resource.data.submitterUid == request.auth.uid);
 allow create: if signedIn()
 && (
 request.resource.data.uid == request.auth.uid
 || request.resource.data.submitterUid == request.auth.uid
 );
 allow update: if isMasterAdmin()
 || (signedIn() && resource.data.uid == request.auth.uid)
 || (signedIn() && resource.data.submitterUid == request.auth.uid);
 allow delete: if isMasterAdmin();
 }
 }
}
