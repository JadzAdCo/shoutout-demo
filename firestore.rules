rules_version = '2';

// FLOQR FIRESTORE RULES VERSION: s3.1.21-data-classification
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR FIRESTORE RULES VERSION: s3.1.11-template-rbac
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR FIRESTORE RULES VERSION: s3.1.0-ads-server-only
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR FIRESTORE RULES VERSION: s3.0.108-feature-services-beta
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR FIRESTORE RULES VERSION: s3.0.103-privacy-consents-owner
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR FIRESTORE RULES VERSION: v29.09.128-shoutout-compliance-logs
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR FIRESTORE RULES VERSION: v29.09.23-entity-feature-gates
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR FIRESTORE RULES VERSION: v29.09.21-heist-display-devices
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR FIRESTORE RULES VERSION: v29.09.5-floqr-platform-payments
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR FIRESTORE RULES VERSION: v29.09.4-app-logging
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR FIRESTORE RULES VERSION: v28.86-mingl-message-action-rules
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR FIRESTORE RULES VERSION: v28.82-mingl-request-chat-rules
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR FIRESTORE RULES VERSION: v28.74-gemini-media-editing-rules
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR FIRESTORE RULES VERSION: v28.70-duplicate-alias-rules
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR FIRESTORE RULES VERSION: v28.59-diagnostic-cleanup-rules
// PREVIOUS PACKAGE MARKER RETAINED FOR DIAGNOSTICS: FLOQR FIRESTORE RULES VERSION: v28.57-mingl-diagnostic-rules
// Last required Firestore rules update added/confirmed:
// - minglGists public read; signed-in create for own authorUid; update/delete own or master
// - clubLocationAliases read/write support for Master Admin duplicate record merge aliases
// - aiMediaEdits owner-visible audit records for Gemini ShoutOut image editing
// - users/{uid} self create/read/update support for onboarding and existing profiles
// - aiCrawlRuns, aiCrawlerSchedules, aiDiagnosticsReports for Master Admin Diagnostics
// - aiIndex, AI notification/preferences, assistant, patron/club template variant, prompt history, Mingl, and chat rule blocks
// - diagnosticRunId-scoped cleanup for temporary Mingl/chat rules smoke-test documents
// - explicit diagnostic-only delete support for temporary Mingl connection records
// - Mingl request audit records, system request messages, and sender-only message edit/action metadata support
// - Mingl read receipts so participants can mark incoming messages read without broad chat access
// - clubOnboardingRecords, promoterOnboardingRecords, clubMedia, and guestListCampaigns for venue onboarding
// - commerce, paid service orders, entity follows, role permissions/activity, staffing requests, campaigns, and Pickup simulations
// - backend-only Stripe Accounts v2 bindings, seller-scoped products, and owner/seller/admin order access
// If Firebase Console does not show this note near the top, Firestore rules are not updated to this package.

service cloud.firestore {
 match /databases/{database}/documents {
 function signedIn() {
 return request.auth != null;
 }

 function isSelf(userId) {
 return signedIn() && request.auth.uid == userId;
 }

 function isMasterAdmin() {
 return signedIn()
 && (
 request.auth.token.masterAdmin == true
 || request.auth.token.email in [
 "bands.don@gmail.com",
 "bans.don@gmail.com",
 "don.b@jadzholdings.com"
 ]
 );
 }

 function isClubManager(clubId) {
 return signedIn()
 && exists(/databases/$(database)/documents/clubLocations/$(clubId))
 && (
 isMasterAdmin()
 || (
 get(/databases/$(database)/documents/clubLocations/$(clubId)).data.adminUids is list
 && request.auth.uid in get(/databases/$(database)/documents/clubLocations/$(clubId)).data.adminUids
 )
 || (
 get(/databases/$(database)/documents/clubLocations/$(clubId)).data.masterAdminUids is list
 && request.auth.uid in get(/databases/$(database)/documents/clubLocations/$(clubId)).data.masterAdminUids
 )
 || (
 request.auth.token.email is string
 && get(/databases/$(database)/documents/clubLocations/$(clubId)).data.adminEmails is list
 && request.auth.token.email in get(/databases/$(database)/documents/clubLocations/$(clubId)).data.adminEmails
 )
 || (
 exists(/databases/$(database)/documents/clubAdminAssignments/$(clubId + "_" + request.auth.uid))
 && get(/databases/$(database)/documents/clubAdminAssignments/$(clubId + "_" + request.auth.uid)).data.status == "active"
 )
 );
 }

 function hasBackendOnlyIdentityFields(data) {
 return data.keys().hasAny([
 "masterAdmin",
 "superAdmin",
 "IsBetaTester",
 "betaTester",
 "roles",
 "approvedRoles",
 "approvedLocations",
 "stripeConnectAccountId",
 "stripeConnectStatus",
 "stripeConnectCapabilityStatus",
 "stripeConnectLivemode",
 "stripeConnectUpdatedAt"
 ]);
 }

 function preservesBackendOnlyIdentityFields() {
 return !request.resource.data.diff(resource.data).changedKeys().hasAny([
 "masterAdmin",
 "superAdmin",
 "IsBetaTester",
 "betaTester",
 "roles",
 "approvedRoles",
 "approvedLocations",
 "stripeConnectAccountId",
 "stripeConnectStatus",
 "stripeConnectCapabilityStatus",
 "stripeConnectLivemode",
 "stripeConnectUpdatedAt"
 ]);
 }

 // Design notes: .cursor/rules/design-notes-staff-marketing-consent.mdc
 function hasStaffMarketingConsent(data) {
 return data.get("marketingMediaConsent", null) is map
 && data.marketingMediaConsent.get("accepted", 0) == 1;
 }

 function isServiceMemberFlag(data) {
 return data.get("IsServiceMember", 0) in [1, "1", true, "true", "yes"];
 }

 function createsServiceMemberWithoutConsent() {
 return isServiceMemberFlag(request.resource.data)
 && !hasStaffMarketingConsent(request.resource.data);
 }

 function startsServiceMembershipWithoutConsent() {
 return isServiceMemberFlag(request.resource.data)
 && !isServiceMemberFlag(resource.data)
 && !hasStaffMarketingConsent(request.resource.data);
 }

 function optInRequestHasConsent() {
 return request.resource.data.get("marketingMediaConsentAccepted", 0) == 1
 && request.resource.data.get("marketingMediaConsentVersion", "") is string
 && request.resource.data.get("marketingMediaConsentVersion", "").size() > 0;
 }

 function preservesStripeBindingFields() {
 return !request.resource.data.diff(resource.data).changedKeys().hasAny([
 "stripeConnectAccountId",
 "stripeConnectStatus",
 "stripeConnectCapabilityStatus",
 "stripeConnectLivemode",
 "stripeConnectUpdatedAt"
 ]);
 }

 function validNewCommerceProduct() {
 return signedIn()
 && request.resource.data.sellerUid == request.auth.uid
 && request.resource.data.sellerEntityId is string
 && (
 request.resource.data.sellerEntityId == request.auth.uid
 || (
 request.resource.data.sellerEntityType == "club"
 && isClubManager(request.resource.data.sellerEntityId)
 )
 )
 && !request.resource.data.keys().hasAny(["stripeConnectAccountId", "connectedAccountId", "paymentStatus"])
 && request.resource.data.keys().hasOnly([
 "sellerEntityId",
 "sellerEntityType",
 "sellerUid",
 "sellerName",
 "name",
 "category",
 "productType",
 "previewMediaType",
 "mediaLicense",
 "priceCents",
 "inventory",
 "imageUrl",
 "description",
 "requiresShipping",
 "active",
 "createdAt",
 "updatedAt"
 ]);
 }

 function isCommerceProductManager() {
 return signedIn()
 && (
 isMasterAdmin()
 || resource.data.sellerUid == request.auth.uid
 || resource.data.sellerEntityId == request.auth.uid
 || (
 resource.data.sellerEntityType == "club"
 && isClubManager(resource.data.sellerEntityId)
 )
 );
 }

 function isCommerceProductUpdate() {
 return isCommerceProductManager()
 && request.resource.data.diff(resource.data).changedKeys().hasOnly([
 "sellerName",
 "name",
 "category",
 "productType",
 "previewMediaType",
 "mediaLicense",
 "priceCents",
 "inventory",
 "imageUrl",
 "description",
 "requiresShipping",
 "active",
 "updatedAt"
 ]);
 }

 function isServiceOrderReader() {
 return signedIn()
 && (
 isMasterAdmin()
 || (
 resource.data.keys().hasAny(["ownerUid"])
 && resource.data.ownerUid == request.auth.uid
 )
 || (
 resource.data.keys().hasAny(["sellerUid"])
 && resource.data.sellerUid == request.auth.uid
 )
 || (
 resource.data.keys().hasAny(["sellerEntityId"])
 && resource.data.sellerEntityId == request.auth.uid
 )
 || (
 resource.data.sellerEntityType == "club"
 && resource.data.sellerEntityId is string
 && isClubManager(resource.data.sellerEntityId)
 )
 || (
 resource.data.clubLocationId is string
 && isClubManager(resource.data.clubLocationId)
 )
 );
 }

 function isMasterFulfillmentUpdate() {
 return isMasterAdmin()
 && request.resource.data.updatedByUid == request.auth.uid
 && request.resource.data.diff(resource.data).changedKeys().hasOnly([
 "shippingStatus",
 "fulfillmentStatus",
 "shippingCarrier",
 "trackingNumber",
 "trackingUrl",
 "updatedByUid",
 "updatedAt"
 ]);
 }

 function createsOwnUid() {
 return signedIn()
 && request.resource.data.uid is string
 && request.resource.data.uid == request.auth.uid;
 }

 function ownsResourceUid() {
 return signedIn()
 && resource.data.uid is string
 && resource.data.uid == request.auth.uid;
 }

 function isParticipant() {
 return signedIn()
 && resource.data.participants is list
 && request.auth.uid in resource.data.participants;
 }

 function isNewParticipant() {
 return signedIn()
 && request.resource.data.participants is list
 && request.auth.uid in request.resource.data.participants;
 }

 function isMessageParty(data) {
 return signedIn()
 && (
 data.get("senderUid", "") == request.auth.uid
 || data.get("recipientUid", "") == request.auth.uid
 || (request.auth.token.email is string
 && request.auth.token.email != ""
 && (data.get("recipientEmail", "") == request.auth.token.email
 || data.get("senderEmail", "") == request.auth.token.email))
 || (data.get("participants", []) is list && request.auth.uid in data.get("participants", []))
 );
 }

 function keepsMessageParties() {
 return request.resource.data.get("senderUid", "") == resource.data.get("senderUid", "")
 && request.resource.data.get("recipientUid", "") == resource.data.get("recipientUid", "")
 && request.resource.data.get("recipientEmail", "") == resource.data.get("recipientEmail", "");
 }

 function isInboxRecipient(data) {
 return signedIn()
 && (
 data.get("recipientUid", "") == request.auth.uid
 || (request.auth.token.email is string
 && request.auth.token.email != ""
 && data.get("recipientEmail", "") == request.auth.token.email)
 );
 }

 // Patrons and club staff may notify each other; server-only kinds and off-site links are refused.
 function isConstrainedInboxCreate() {
 let d = request.resource.data;
 return signedIn()
 && d.recipientUid is string
 && d.recipientUid.size() > 0
 && d.recipientUid.size() <= 128
 && !(d.get("type", "") in [
 "betaInvite", "paidShoutoutReceipt", "adCampaignPending", "adCampaignApproved",
 "adCampaignRejected", "adInvoice", "suprstarApproved", "suprstarRejected",
 "suprstarPending", "entityCampaign", "orderTracking", "displaySecurity",
 "twilioDebugger", "scheduleShift"
 ])
 && d.get("deleted", false) == false
 && (d.get("link", "") == ""
 || (d.get("link", "") is string && d.get("link", "").matches("^[.]/[A-Za-z0-9_-]+[.]html.*")))
 && (
 d.recipientUid == request.auth.uid
 || d.get("createdByUid", "") == request.auth.uid
 || d.get("requesterUid", "") == request.auth.uid
 );
 }

 function suprstrSessionAcceptsCandidates(sessionId) {
 let session = get(/databases/$(database)/documents/suprstrSessions/$(sessionId)).data;
 return session.get("status", "") in ["waiting", "offering", "connected"]
 && request.time < session.createdAt + duration.value(4, "h");
 }

 function isIceCandidateShape() {
 let d = request.resource.data;
 return d.keys().hasOnly(["candidate", "sdpMid", "sdpMLineIndex", "usernameFragment"])
 && d.candidate is string
 && d.candidate.size() <= 2048;
 }

 function isDiagnosticResource() {
 return signedIn()
 && resource.data.diagnosticRunId is string;
 }

 function isDiagnosticParticipantResource() {
 return isDiagnosticResource()
 && resource.data.participants is list
 && request.auth.uid in resource.data.participants;
 }

 function isDiagnosticParticipantRequest() {
 return signedIn()
 && request.resource.data.diagnosticRunId is string
 && request.resource.data.participants is list
 && request.auth.uid in request.resource.data.participants;
 }

 function isMutualMingl(connectionId) {
 return signedIn()
 && exists(/databases/$(database)/documents/minglConnections/$(connectionId))
 && get(/databases/$(database)/documents/minglConnections/$(connectionId)).data.status == "mutual"
 && (
 (
 get(/databases/$(database)/documents/minglConnections/$(connectionId)).data.participants is list
 && request.auth.uid in get(/databases/$(database)/documents/minglConnections/$(connectionId)).data.participants
 ) ||
 get(/databases/$(database)/documents/minglConnections/$(connectionId)).data.requestedBy == request.auth.uid ||
 get(/databases/$(database)/documents/minglConnections/$(connectionId)).data.requestedTo == request.auth.uid
 );
 }

 function isExistingMinglRoom() {
 return resource.data.type == "mingl";
 }

 function isNewMinglRoom() {
 return request.resource.data.type == "mingl";
 }

 function isExistingMinglMessage() {
 return resource.data.keys().hasAny(["roomType"])
 && resource.data.roomType == "mingl";
 }

 function isNewMinglMessage() {
 return request.resource.data.keys().hasAny(["roomType"])
 && request.resource.data.roomType == "mingl";
 }

 function isMinglSystemMessageRequest() {
 return isNewMinglMessage()
 && request.resource.data.senderUid == "system"
 && request.resource.data.messageType in ["system", "backgroundConsent"]
 && request.resource.data.participants is list
 && request.auth.uid in request.resource.data.participants;
 }

 function isOwnMinglMessageEdit() {
 return isExistingMinglMessage()
 && resource.data.senderUid == request.auth.uid
 && request.resource.data.senderUid == resource.data.senderUid
 && request.resource.data.roomId == resource.data.roomId
 && request.resource.data.roomType == resource.data.roomType
 && request.resource.data.participants == resource.data.participants
 && request.resource.data.diff(resource.data).changedKeys().hasOnly([
 "body",
 "edited",
 "editedAt",
 "updatedAt",
 "aiGrammarApplied",
 "animationType",
 "animatedAt",
 "unsent",
 "deleteAfterRead",
 "deleteAfterReadSetAt"
 ]);
 }

 function isMinglDeleteAfterReadExpiry() {
 return isExistingMinglMessage()
 && resource.data.deleteAfterRead == true
 && resource.data.deletedAfterRead != true
 && resource.data.participants is list
 && request.auth.uid in resource.data.participants
 && resource.data.senderUid != request.auth.uid
 && request.resource.data.senderUid == resource.data.senderUid
 && request.resource.data.roomId == resource.data.roomId
 && request.resource.data.roomType == resource.data.roomType
 && request.resource.data.participants == resource.data.participants
 && request.resource.data.body == "Message deleted after read."
 && request.resource.data.diff(resource.data).changedKeys().hasOnly([
 "body",
 "deletedAfterRead",
 "expiredAt",
 "expiredByUid",
 "updatedAt"
 ]);
 }

 function isMinglReadReceiptUpdate() {
 return isExistingMinglMessage()
 && resource.data.participants is list
 && request.auth.uid in resource.data.participants
 && resource.data.senderUid != request.auth.uid
 && request.resource.data.senderUid == resource.data.senderUid
 && request.resource.data.roomId == resource.data.roomId
 && request.resource.data.roomType == resource.data.roomType
 && request.resource.data.participants == resource.data.participants
 && request.resource.data.readBy is map
 && request.resource.data.readAtBy is map
 && request.resource.data.readBy[request.auth.uid] == true
 && request.resource.data.diff(resource.data).changedKeys().hasOnly([
 "readBy",
 "readAtBy",
 "updatedAt"
 ]);
 }

 function isMinglBackgroundConsentUpdate() {
 return isExistingMinglMessage()
 && resource.data.messageType == "backgroundConsent"
 && resource.data.backgroundTargetUid == request.auth.uid
 && request.resource.data.senderUid == resource.data.senderUid
 && request.resource.data.roomId == resource.data.roomId
 && request.resource.data.roomType == resource.data.roomType
 && request.resource.data.participants == resource.data.participants
 && request.resource.data.diff(resource.data).changedKeys().hasOnly([
 "backgroundConsentStatus",
 "responseByUid",
 "respondedAt",
 "updatedAt"
 ]);
 }

 match /users/{userId} {
 allow create: if isSelf(userId)
 && !hasBackendOnlyIdentityFields(request.resource.data)
 && !createsServiceMemberWithoutConsent();
 // Other patrons' profiles come from the getPeopleDirectory callable (private fields stripped).
 allow read: if isSelf(userId) || isMasterAdmin();
 allow update: if isSelf(userId)
 && preservesBackendOnlyIdentityFields()
 && !startsServiceMembershipWithoutConsent();
 allow delete: if isParticipant()
 && isDiagnosticResource();
 }

 match /clubs/{id} {
 allow read: if true;
 allow write: if signedIn();
 }

 match /clubLocations/{id} {
 allow read: if true;
 allow create: if isMasterAdmin()
 && !request.resource.data.keys().hasAny([
 "stripeConnectAccountId",
 "stripeConnectStatus",
 "stripeConnectCapabilityStatus",
 "stripeConnectLivemode",
 "stripeConnectUpdatedAt"
 ]);
 allow update: if (isMasterAdmin() || isClubManager(id))
 && preservesStripeBindingFields();
 allow delete: if isMasterAdmin();
 }

 // Platform-wide Master Admin settings (patron feature gates, etc.)
 match /platformSettings/{docId} {
 allow read: if true;
 allow write: if isMasterAdmin();
 }

 // Features & Services — written only by Cloud Functions (SOS2FA + audit chain).
 match /featureServices/{featureKey} {
 allow read: if signedIn();
 allow write: if false;
 }

 match /betaTesters/{uid} {
 allow read: if isSelf(uid) || isMasterAdmin();
 allow write: if false;
 }

 match /betaInvites/{inviteId} {
 allow read: if isMasterAdmin();
 allow write: if false;
 }

 match /featureServiceAuditLogs/{eventId} {
 allow read: if isMasterAdmin();
 allow write: if false;
 }

 match /featureServiceAuditHead/{docId} {
 allow read: if isMasterAdmin();
 allow write: if false;
 }

 // Data classification register: Master Admin read; writes only via SOS2FA callables.
 match /dataClassification/{docId} {
 allow read: if isMasterAdmin();
 allow write: if false;
 }

 match /floqAiAccessThrottle/{uid} {
 allow read, write: if false;
 }

 // Staff marketing media consent evidence: written only by recordStaffMarketingConsent.
 match /staffMarketingConsentLogs/{logId} {
 allow read: if isMasterAdmin();
 allow write: if false;
 }

 match /staffMarketingConsentThrottle/{uid} {
 allow read, write: if false;
 }

 match /featureServiceAccessThrottle/{uid} {
 allow read, write: if false;
 }

 match /clubLocationAliases/{aliasId} {
 allow read: if true;
 allow write: if signedIn();
 }

 match /clubAdminAssignments/{assignmentId} {
 allow read: if isMasterAdmin()
 || resource.data.patronUid == request.auth.uid
 || (
 resource.data.clubLocationId is string
 && isClubManager(resource.data.clubLocationId)
 )
 || (
 resource.data.clubId is string
 && isClubManager(resource.data.clubId)
 );
 allow create: if isMasterAdmin()
 || (
 request.resource.data.clubLocationId is string
 && isClubManager(request.resource.data.clubLocationId)
 )
 || (
 request.resource.data.clubId is string
 && isClubManager(request.resource.data.clubId)
 );
 allow update, delete: if isMasterAdmin()
 || (
 resource.data.clubLocationId is string
 && isClubManager(resource.data.clubLocationId)
 )
 || (
 resource.data.clubId is string
 && isClubManager(resource.data.clubId)
 );
 }

 // OTP challenges contain hashes and rate-limit data; clients never read or write them.
 match /emailOtpChallenges/{challengeId} {
 allow read, write: if false;
 }

 match /events/{id} {
 allow read: if true;
 allow write: if signedIn();
 }

 match /templates/{id} {
 allow read: if true;
 allow write: if isMasterAdmin();
 }

 // Template RBAC (s3.1.11) — design notes: .cursor/rules/design-notes-template-discovery-idle.mdc
 function hasTemplateRole(clubId, roles) {
 return signedIn()
 && exists(/databases/$(database)/documents/venueTemplateRoles/$(clubId + "_" + request.auth.uid))
 && get(/databases/$(database)/documents/venueTemplateRoles/$(clubId + "_" + request.auth.uid)).data.status == "active"
 && get(/databases/$(database)/documents/venueTemplateRoles/$(clubId + "_" + request.auth.uid)).data.role in roles;
 }

 function canAdministerTemplates(clubId) {
 return isClubManager(clubId) || hasTemplateRole(clubId, ["administrator"]);
 }

 function canManageTemplates(clubId) {
 return canAdministerTemplates(clubId) || hasTemplateRole(clubId, ["manager"]);
 }

 function validVenueTemplateTags(tagId) {
 return signedIn()
 && request.resource.data.keys().hasOnly(["clubLocationId", "templateId", "tags", "updatedByUid", "updatedByEmail", "updatedAt", "revision"])
 && request.resource.data.clubLocationId is string
 && request.resource.data.templateId is string
 && tagId == request.resource.data.clubLocationId + "__" + request.resource.data.templateId
 && request.resource.data.tags is list
 && request.resource.data.tags.size() <= 30
 && request.resource.data.updatedByUid == request.auth.uid;
 }

 match /venueTemplateRoles/{roleId} {
 allow get: if signedIn()
 && (resource.data.uid == request.auth.uid || isClubManager(resource.data.clubLocationId));
 allow create, update: if signedIn()
 && request.resource.data.keys().hasOnly(["clubLocationId", "uid", "email", "displayName", "role", "status", "grantedByUid", "grantedByEmail", "updatedAt"])
 && request.resource.data.clubLocationId is string
 && request.resource.data.uid is string
 && roleId == request.resource.data.clubLocationId + "_" + request.resource.data.uid
 && request.resource.data.role in ["administrator", "manager"]
 && request.resource.data.status in ["active", "revoked"]
 && request.resource.data.grantedByUid == request.auth.uid
 && isClubManager(request.resource.data.clubLocationId)
 && (resource == null || resource.data.clubLocationId == request.resource.data.clubLocationId);
 allow delete: if signedIn() && isClubManager(resource.data.clubLocationId);
 }

 match /venueTemplateTags/{tagId} {
 allow read: if true;
 allow create: if validVenueTemplateTags(tagId)
 && canManageTemplates(request.resource.data.clubLocationId);
 allow update: if validVenueTemplateTags(tagId)
 && request.resource.data.clubLocationId == resource.data.clubLocationId
 && request.resource.data.templateId == resource.data.templateId
 && (
 canAdministerTemplates(resource.data.clubLocationId)
 || (canManageTemplates(resource.data.clubLocationId) && request.resource.data.tags.hasAll(resource.data.tags))
 );
 allow delete: if signedIn() && canAdministerTemplates(resource.data.clubLocationId);
 }

 function validPatronShoutoutCreate() {
 return signedIn()
 && request.resource.data.keys().hasAll([
 'template', 'screenFormatId', 'mainText', 'subText', 'submittedByUid',
 'maxMainCharacters', 'maxSubCharacters', 'lineCount', 'maxCharactersPerLine'
 ])
 && request.resource.data.template == 'blackwhite'
 && request.resource.data.submittedByUid == request.auth.uid
 && request.resource.data.mainText is string
 && request.resource.data.subText is string
 && request.resource.data.lineCount == 3
 && (
 ((request.resource.data.screenFormatId == 'p125-96x48' || request.resource.data.screenFormatId == 'led-96x48')
 && request.resource.data.mainText.size() <= 47
 && request.resource.data.subText.size() <= 20
 && request.resource.data.maxMainCharacters == 45
 && request.resource.data.maxCharactersPerLine == 15)
 || (request.resource.data.screenFormatId == 'p125-64x32'
 && request.resource.data.mainText.size() <= 44
 && request.resource.data.subText.size() <= 18
 && request.resource.data.maxMainCharacters == 42
 && request.resource.data.maxCharactersPerLine == 14)
 || ((request.resource.data.screenFormatId == 'p125-64x48' || request.resource.data.screenFormatId == 'led-64x48')
 && request.resource.data.mainText.size() <= 38
 && request.resource.data.subText.size() <= 18
 && request.resource.data.maxMainCharacters == 36
 && request.resource.data.maxCharactersPerLine == 12)
 || (request.resource.data.screenFormatId == 'led-64x32'
 && request.resource.data.mainText.size() <= 32
 && request.resource.data.subText.size() <= 14
 && request.resource.data.maxMainCharacters == 30
 && request.resource.data.maxCharactersPerLine == 10)
 );
 }

 // Free (no priceCents) templates other than Traditional B&W and paid football/heist art.
 function validFreePatronShoutoutCreate() {
 return signedIn()
 && request.resource.data.keys().hasAll(['template', 'mainText', 'submittedByUid'])
 && request.resource.data.template is string
 && request.resource.data.template != 'blackwhite'
 && request.resource.data.template != 'zebbiesFootballTeamIntro'
 && request.resource.data.template != 'heistVaultNight'
 && request.resource.data.template != 'heistNeonMask'
 && request.resource.data.template != 'heistDupontUnder'
 && request.resource.data.template != 'heistRedLux'
 && request.resource.data.submittedByUid == request.auth.uid
 && request.resource.data.mainText is string
 && request.resource.data.mainText.size() <= 120;
 }

 match /shoutouts/{id} {
 allow create: if validPatronShoutoutCreate() || validFreePatronShoutoutCreate();
 allow read, update, delete: if signedIn();
 }

 match /liveContent/{id} {
 allow read: if true;
 allow write: if signedIn();
 }

 // LED player device → club binding. Public read so display.html?ip= can resolve without auth.
 // Master Admin / signed-in operators write bindings (ip, locationId).
 match /displayDevices/{deviceId} {
 allow read: if true;
 allow create, update, delete: if signedIn();
 }

 // Display page access attempts (IP + UA). Written only by Cloud Functions (Admin SDK).
 match /displayAccessLogs/{id} {
 allow read: if isMasterAdmin();
 allow create, update, delete: if false;
 }

 // Per-board display URL secrets (?k=). Never public — Master Admin + Admin SDK only.
 match /displayBoardSecrets/{locationId} {
 allow read: if isMasterAdmin();
 allow create, update, delete: if false;
 }

 match /guestListRequests/{id} {
 allow create: if signedIn();
 allow read, update, delete: if signedIn();
 }

 match /guestListCampaigns/{id} {
 allow read: if true;
 allow create, update, delete: if signedIn();
 }

 match /commerceProducts/{id} {
 allow read: if true;
 allow create: if validNewCommerceProduct();
 allow update: if isCommerceProductUpdate();
 allow delete: if isCommerceProductManager();
 }

 match /serviceOrders/{id} {
 allow read: if isServiceOrderReader();
 allow create, delete: if false;
 allow update: if isMasterFulfillmentUpdate();
 }

 // Operational application logs for Master Admin Logging.
 match /appLogs/{id} {
 allow create: if signedIn()
 && request.resource.data.keys().hasAll(['level', 'category', 'message', 'uid', 'createdAt'])
 && request.resource.data.uid == request.auth.uid
 && request.resource.data.level in ['debug', 'info', 'warn', 'error']
 && request.resource.data.category is string
 && request.resource.data.category.size() <= 80
 && request.resource.data.message is string
 && request.resource.data.message.size() <= 2000;
 allow read: if isMasterAdmin()
 || (signedIn() && resource.data.uid == request.auth.uid);
 allow update: if false;
 allow delete: if isMasterAdmin();
 }

 // Twilio Debugger / error-log webhook events (Admin SDK writes only).
 match /twilioDebuggerEvents/{id} {
 allow read: if isMasterAdmin();
 allow create, update, delete: if false;
 }

 // System-generated mail (SendGrid). Functions write; Master Admin search/view.
 match /systemMailLogs/{id} {
 allow read: if isMasterAdmin();
 allow create, update, delete: if false;
 }

 // Twilio SMS / WhatsApp / feature / GRC compliance logs. Functions write.
 // Master Admin: all rows. Club managers: SMS/WhatsApp for their clubLocationId only.
 match /twilioSmsLogs/{id} {
 allow read: if isMasterAdmin()
 || (
 resource.data.clubLocationId is string
 && isClubManager(resource.data.clubLocationId)
 );
 allow create, update, delete: if false;
 }
 match /twilioWhatsAppLogs/{id} {
 allow read: if isMasterAdmin()
 || (
 resource.data.clubLocationId is string
 && isClubManager(resource.data.clubLocationId)
 );
