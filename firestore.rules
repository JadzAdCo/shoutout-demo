 match /clubMedia/{id} {
 allow read: if true;
 allow create, update, delete: if signedIn();
 }

 match /messages/{id} {
 allow read: if isMasterAdmin() || isMessageParty(resource.data);
 allow create: if isMasterAdmin()
 || (signedIn()
 && (
 request.resource.data.get("senderUid", "") == request.auth.uid
 || (request.resource.data.get("senderUid", "") == "system"
 && request.resource.data.get("requesterUid", "") == request.auth.uid)
 ));
 allow update: if isMasterAdmin() || (isMessageParty(resource.data) && keepsMessageParties());
 allow delete: if isMasterAdmin() || isMessageParty(resource.data);
 }

 match /privacyConsents/{id} {
 allow create: if signedIn()
 && request.resource.data.uid is string
 && request.resource.data.uid == request.auth.uid;
