 }

 match /inboxNotifications/{id} {
 allow read, update, delete: if isMasterAdmin() || isInboxRecipient(resource.data);
 allow create: if isMasterAdmin() || isConstrainedInboxCreate();
 }

 match /userBlocks/{blockId} {
 allow read: if signedIn()
 && resource.data.participants is list
 && request.auth.uid in resource.data.participants;
 allow create: if signedIn()
 && request.resource.data.participants is list
 && request.resource.data.participants.size() == 2
 && request.auth.uid in request.resource.data.participants
 && request.resource.data.blockedBy == request.auth.uid
 && request.resource.data.blockedUid is string
 && request.resource.data.blockedUid != request.auth.uid;
 allow update: if signedIn()
 && resource.data.participants is list
 && request.auth.uid in resource.data.participants
 && (
 request.auth.uid == resource.data.blockedBy
 || request.auth.uid == resource.data.blockedUid
 );
 allow delete: if signedIn()
 && resource.data.blockedBy == request.auth.uid;
 }

 match /schedulingSubscriptions/{id} {
 allow read: if isMasterAdmin() || isClubManager(resource.data.get("clubLocationId", "none"));
 allow write: if false;
 }

 match /suprstrEntitlements/{uid} {
