 }
 match /twilioFeatureLogs/{id} {
 allow read: if isMasterAdmin();
 allow create, update, delete: if false;
 }
 match /twilioComplianceLogs/{id} {
 allow read: if isMasterAdmin();
 allow create, update, delete: if false;
 }

 // SOS2FA challenges, sessions, and authenticator secrets (Admin SDK / Functions only).
 match /sos2faChallenges/{uid} {
